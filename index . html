<script>
let products = JSON.parse(localStorage.getItem('bake_products')) || [
{name:"Chocolate Truffle", price:549, img:"https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=500", tag:"Bestseller"},
{name:"Red Velvet Cake", price:649, img:"https://images.unsplash.com/photo-1586788680434-30d324b2d46f?w=500", tag:"20% OFF"},
{name:"Strawberry Cake", price:599, img:"https://images.unsplash.com/photo-1565958011703-44f9829ba187?w=500", tag:"New"},
{name:"Butter Croissant (4pc)", price:199, img:"https://images.unsplash.com/photo-1555507036-ab1f4038808a?w=500", tag:"Fresh"},
{name:"Choco Cupcakes (6pc)", price:299, img:"https://images.unsplash.com/photo-1606890737304-57a1ca8a5b62?w=500", tag:"Combo"},
{name:"Fresh Milk Bread", price:99, img:"https://images.unsplash.com/photo-1509440159596-0249088772ff?w=500", tag:"Daily"},
{name:"Berry Celebration Cake", price:899, img:"https://images.unsplash.com/photo-1535141192574-5d4897c12636?w=500", tag:"Premium"},
{name:"Vanilla Celebration", price:749, img:"https://images.unsplash.com/photo-1621303837174-89787a7d4729?w=500", tag:"Customizable"}
];
let cart = JSON.parse(localStorage.getItem('bake_cart')) || [];
let orders = JSON.parse(localStorage.getItem('bake_orders')) || [];
let activeCoupon = "";

function save(){localStorage.setItem('bake_products',JSON.stringify(products));localStorage.setItem('bake_cart',JSON.stringify(cart));localStorage.setItem('bake_orders',JSON.stringify(orders));}

function renderProducts(){
document.getElementById('productGrid').innerHTML = products.map((p,i)=>`
<div class="card"><span class="tag">${p.tag||'Fresh'}</span>
<img src="${p.img}"><div class="card-body">
<h3>${p.name}</h3><div class="price">Rs.${p.price}</div>
<div>⭐ 4.8 | 500+ ordered</div><br>
<button class="btn" style="width:100%" onclick="addToCart(${i})">Add to Cart</button>
</div></div>`).join('');
}
function addToCart(i){cart.push(products[i]);save();renderCart();toggleCart(true);}
function calcCustom(){
let f=document.getElementById('cFlavor');let s=document.getElementById('cSize');let t=document.getElementById('cTop');
let total=parseInt(s.value)+parseInt(f.value)+parseInt(t.value);
document.getElementById('customPrice').innerText='Rs.'+total;
document.getElementById('previewText').innerText=f.options[f.selectedIndex].text.split('(')[0]+' - '+s.options[s.selectedIndex].text.split('-')[0];
document.getElementById('previewMsg').innerText='"'+document.getElementById('cMsg').value+'"';
return total;
}
function addCustomToCart(){
let total=calcCustom();
let name="Custom: "+document.getElementById('previewText').innerText;
cart.push({name,price:total,img:"https://images.unsplash.com/photo-1621303837174-89787a7d4729?w=500",tag:"Custom"});
save();renderCart();toggleCart(true);
}
function toggleCart(open){document.getElementById('cartSidebar').classList.toggle('open',open);renderCart();}
function getTotals(){
let sub=cart.reduce((a,c)=>a+c.price,0);let disc=0;
if(activeCoupon==="FIRST50") disc=Math.min(Math.round(sub*0.5),150);
if(activeCoupon==="FESTIVE20") disc=Math.round(sub*0.2);
if(activeCoupon==="FREEDEL" && sub>499) disc=50;
return{sub,disc,total:sub-disc};
}
function renderCart(){
document.getElementById('cartCount').innerText=cart.length;
document.getElementById('cartItems').innerHTML=cart.length?cart.map((c,i)=>`
<div class="cart-item"><img src="${c.img}"><div><b>${c.name}</b><br>Rs.${c.price}<br><button onclick="removeCart(${i})" style="color:red;border:none;background:none;cursor:pointer">Remove</button></div></div>`).join(''):'<p style="text-align:center;color:#888">Cart empty. Add some cakes! 🍰</p>';
let t=getTotals();
document.getElementById('subTotal').innerText='Rs.'+t.sub;
document.getElementById('discount').innerText='-Rs.'+t.disc;
document.getElementById('grandTotal').innerText='Rs.'+t.total;
}
function removeCart(i){cart.splice(i,1);save();renderCart();}
function applyCoupon(code){activeCoupon=code;document.getElementById('coupon').value=code;renderCart();alert(code+" applied!");}
function openCheckout(){
if(!cart.length){alert("Cart is empty!");return;}
toggleCart(false);
document.getElementById('payAmount').innerText='Rs.'+getTotals().total;
document.getElementById('checkoutModal').classList.add('open');
}
function placeOrder(){
let name=document.getElementById('custName').value;
let phone=document.getElementById('custPhone').value;
let addr=document.getElementById('custAddr').value;
if(!name||!phone||!addr){alert("Please fill name, phone & address");return;}
let pay=document.querySelector('input[name="pay"]:checked').value;
let t=getTotals();
let id='BE-'+Math.floor(1000+Math.random()*9000);
orders.unshift({id,customer:name+" ("+phone+")",address:addr,items:cart.map(c=>c.name).join(', '),total:t.total,payment:pay,status:'Received',date:new Date().toLocaleString()});
cart=[];activeCoupon="";save();renderCart();
document.getElementById('checkoutModal').classList.remove('open');
alert("Order Placed! Your Order ID is "+id+" . Use it to Track.");
document.getElementById('trackInput').value=id;
document.getElementById('track').scrollIntoView();trackOrder();
}
function trackOrder(){
let id=document.getElementById('trackInput').value.trim();
let o=orders.find(x=>x.id===id);
document.getElementById('trackResult').innerHTML=o?`<h3>Order ${o.id} - <span class="status ${o.status.split(' ')[0]}">${o.status}</span></h3><p>${o.items}</p><p><b>Total Rs.${o.total} | ${o.payment}</b></p><p>Received → Baking → Ready → Out for Delivery → Delivered</p>`:`<p style="color:red">Order not found. Check ID.</p>`;
}
function showView(v){
document.getElementById('homeView').style.display=v==='home'?'block':'none';
document.getElementById('adminView').style.display=v==='admin'?'block':'none';
if(v==='admin') renderAdmin();
window.scrollTo(0,0);
}
function renderAdmin(){
document.getElementById('stOrders').innerText=orders.length;
document.getElementById('stRevenue').innerText='Rs.'+orders.reduce((a,o)=>a+o.total,0);
document.getElementById('stPending').innerText=orders.filter(o=>o.status!=='Delivered').length;
document.getElementById('orderTable').innerHTML=orders.length?orders.map((o,i)=>`<tr><td><b>${o.id}</b><br><small>${o.date}</small></td><td>${o.customer}</td><td>${o.items}</td><td>Rs.${o.total}</td><td>${o.payment}</td><td><select onchange="updateStatus(${i},this.value)">${['Received','Baking','Ready','Out for Delivery','Delivered'].map(s=>`<option ${s===o.status?'selected':''}>${s}</option>`).join('')}</select></td></tr>`).join(''):'<tr><td colspan="6" style="text-align:center">No orders yet</td></tr>';
}
function updateStatus(i,val){orders[i].status=val;save();renderAdmin();}
function addProduct(){
let n=document.getElementById('pName').value;let p=parseInt(document.getElementById('pPrice').value);
if(!n||!p){alert("Enter name & price");return;}
products.push({name:n,price:p,img:"https://images.unsplash.com/photo-1558961363-fa8fdf82db35?w=500",tag:"New"});
save();renderProducts();alert("Product added!");
}
document.getElementById('coupon').addEventListener('change',e=>{activeCoupon=e.target.value;renderCart();});
renderProducts();renderCart();calcCustom();
</script>
</body>
</html>
