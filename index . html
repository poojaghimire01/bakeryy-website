</header>

<!-- CUSTOMER VIEW -->
<div id="homeView">
<div class="hero">
<div class="hero-text">
<h1>Freshly Baked <span>Happiness</span> Delivered Home</h1>
<p>Showcase, customize and order cakes online. Same-day delivery, easy UPI payment & live tracking for local bakeries.</p>
<button class="btn" onclick="document.getElementById('menu').scrollIntoView()">Shop Now</button>
<button class="btn btn-gold" onclick="document.getElementById('customize').scrollIntoView()">Customize Cake</button>
<div class="badges"><div class="badge">⭐ 4.9 Rated</div><div class="badge">🚚 Same Day Delivery</div><div class="badge">🍞 Fresh Daily</div></div>
</div>
