.Received{background:#fff3cd}.Baking{background:#ffe0b2}.Ready{background:#bbdefb}.Out{background:#e1bee7}.Delivered{background:#c8e6c9}
table{width:100%;border-collapse:collapse;background:#fff;border-radius:10px;overflow:hidden;font-size:14px}
