<label>Flavor</label>
<select id="cFlavor" onchange="calcCustom()"><option value="0">Chocolate (+ Rs.0)</option><option value="100">Red Velvet (+ Rs.100)</option><option value="80">Butterscotch (+ Rs.80)</option><option value="120">Pineapple (+ Rs.120)</option><option value="150">Photo Cake (+ Rs.150)</option></select>
