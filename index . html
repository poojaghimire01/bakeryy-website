<div class="offer-box">
<div class="offer"><h3>50% OFF First Order</h3><p>Up to Rs.150 off</p><code>FIRST50</code><br><button class="btn btn-gold" onclick="applyCoupon('FIRST50')">Apply</button></div>
<div class="offer"><h3>Festive 20% OFF</h3><p>On all 1kg+ cakes</p><code>FESTIVE20</code><br><button class="btn" style="background:#fff;color:#FF6B8B" onclick="applyCoupon('FESTIVE20')">Apply</button></div>
<div class="offer"><h3>Free Delivery</h3><p>On orders above Rs.499</p><code>FREEDEL</code><br><button class="btn btn-gold" onclick="applyCoupon('FREEDEL')">Apply</button></div>
</div>
